{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@app/shared": ["../../shared/src/index.ts"],
      "@app/shared/*": ["../../shared/src/*"],
      "@app/core": ["../../core/src/index.ts"],
      "@app/core/*": ["../../core/src/*"]
    }
  },
  "include": ["src/**/*", "../../shared/src/**/*", "../../core/src/**/*"]
}
