{
  "name": "app-web",
  "private": true,
  "scripts": {
    "start": "pnpm dev",
    "dev": "pnpm -r --parallel --filter @app/main --filter @app/app dev",
    "dev:full": "pnpm -r --parallel --filter @app/main --filter @app/app --filter @app/theme-editor dev",
    "dev:main": "pnpm --filter @app/main dev",
    "dev:app": "pnpm --filter @app/app dev",
    "build": "pnpm --filter @app/main build && pnpm --filter @app/app build",
    "build:main": "pnpm --filter @app/main build",
    "build:app": "pnpm --filter @app/app build",
    "preview": "pnpm --filter @app/main preview",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "clean": "pnpm -r clean",
    "type-check": "pnpm -r type-check",
    "setup": "pnpm install && pnpm type-check",
    "doctor": "node scripts/doctor.mjs",
    "create": "node scripts/create-app.mjs",
    "create:app": "node scripts/create-app.mjs",
    "dev:theme": "pnpm --filter @app/theme-editor dev"
  },
  "devDependencies": {
    "typescript": "~5.8.0"
  }
}
