{
  "name": "app-web",
  "private": true,
  "scripts": {
    "start": "pnpm dev",
    "dev": "pnpm -r --parallel --filter @app/main --filter @app/app dev",
    "dev:full": "pnpm -r --parallel --filter @app/main --filter @app/app --filter @app/theme-editor dev",
    "dev:main": "pnpm --filter @app/main dev",
    "dev:app": "pnpm --filter @app/app dev",
    "build": "pnpm --filter @app/main build && pnpm --filter @app/app build",
    "build:main": "pnpm --filter @app/main build",
    "build:app": "pnpm --filter @app/app build",
    "preview": "pnpm --filter @app/main preview",
    "lint": "eslint . && pnpm -r --if-present lint",
    "lint:fix": "eslint . --fix && pnpm -r --if-present lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" && pnpm -r --if-present format",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\" && pnpm -r --if-present format:check",
    "clean": "pnpm -r clean",
    "type-check": "pnpm -r type-check",
    "check": "pnpm type-check && pnpm lint && pnpm format:check",
    "setup": "node scripts/setup-env.mjs && pnpm install && pnpm type-check",
    "prepare": "husky || true",
    "postinstall": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "create": "node scripts/create-app.mjs",
    "create:app": "node scripts/create-app.mjs",
    "dev:theme": "pnpm --filter @app/theme-editor dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
