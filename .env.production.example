# 生产环境环境变量配置示例
# 复制此文件为 .env.production 并填入实际值
# ⚠️ 不要将 .env.production 提交到 Git！

# ============= 应用配置 =============
# 管理员默认密码（强烈建议使用强密码）
APP_DEFAULT_ROOT_PASS=your_secure_password_here

# ============= 数据库配置 =============
DB_HOST=localhost
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=template

# ============= JWT配置 =============
# JWT密钥（必须至少32字符，建议使用以下命令生成）:
# openssl rand -base64 48
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long

# ============= Redis配置（可选）=============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============= CORS配置（可选）=============
CORS_ENABLED=false  # 生产环境通常不需要CORS（前后端同域）

# ============= 其他配置（可选）=============
APP_APP_MODE=release
APP_APP_PORT=7500
LOG_LEVEL=info
